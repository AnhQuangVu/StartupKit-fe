 class="flex lg:gap-6 gap-3 ng-tns-c20-3"><span _ngcontent-sc20="" class="lg:text-[100px] text-[42px] optima-font ng-tns-c20-3"> one </span><app-text-stroke _ngcontent-sc20="" text="investment" class="lg:block hidden ng-tns-c20-3 ng-tns-c1-4 ng-star-inserted" _nghost-sc1=""><div _ngcontent-sc1="" class="flex ng-tns-c1-4 ng-star-inserted"><div _ngcontent-sc1="" class="main-text relative font-bold optima-font italic ng-tns-c1-4" style="font-size:100px;"> investment <div _ngcontent-sc1="" class="yellow-stroke absolute left-0 bottom-[15%] ng-tns-c1-4"><svg _ngcontent-sc1="" viewBox="0 0 130 12" xmlns="http://www.w3.org/2000/svg" class="yellow-stroke-svg ng-tns-c1-4 ng-trigger ng-trigger-strokeAnimation" style=""><!----><path _ngcontent-sc1="" d="M3 8.99999C35.7456 1.93537 81.7418 0.116179 127 9" stroke="#E6A849" stroke-width="3" stroke-linecap="round" fill="none" class="ng-tns-c1-4 ng-star-inserted" style=""></path><!----><!----><!----></svg></div></div></div><!----></app-text-stroke><app-text-stroke _ngcontent-sc20="" text="investment" class="lg:hidden ng-tns-c20-3 ng-tns-c1-5 ng-star-inserted" _nghost-sc1=""><div _ngcontent-sc1="" class="flex ng-tns-c1-5 ng-star-inserted"><div _ngcontent-sc1="" class="main-text relative font-bold optima-font italic ng-tns-c1-5" style="font-size:42px;"> investment <div _ngcontent-sc1="" class="yellow-stroke absolute left-0 bottom-[15%] ng-tns-c1-5"><svg _ngcontent-sc1="" viewBox="0 0 130 12" xmlns="http://www.w3.org/2000/svg" class="yellow-stroke-svg ng-tns-c1-5 ng-trigger ng-trigger-strokeAnimation" style=""><!----><path _ngcontent-sc1="" d="M3 8.99999C35.7456 1.93537 81.7418 0.116179 127 9" stroke="#E6A849" stroke-width="3" stroke-linecap="round" fill="none" class="ng-tns-c1-5 ng-star-inserted" style=""></path><!----><!----><!----></svg></div></div></div><!----></app-text-stroke><span _ngcontent-sc20="" class="lg:text-[100px] text-[42px] optima-font ng-tns-c20-3 ng-star-inserted"> at a time </span><!----></div><!----></div></div><div _ngcontent-sc20="" class="flex ng-tns-c20-3"><div _ngcontent-sc20="" class="bg-ts-yellow text-white lg:py-3 py-2 lg:px-10 px-5 rounded-[60px] lg:text-[28px] text-[20px] flex items-center gap-2 ease-in-out-2 hover:scale-105 cursor-pointer ng-tns-c20-3"> Learn more about us <img _ngcontent-sc20="" height="24" width="24" src="assets/imgs/ts-icon.svg" alt="" class="ng-tns-c20-3"></div></div></div><div _ngcontent-sc20="" class="absolute bottom-0 left-[50%] translate-x-[-50%] border-2 border-white mb-5 rounded-full ng-tns-c20-3" style="padding-top: 45px;"><i _ngcontent-sc20="" class="pi pi-chevron-down !text-[30px] text-white p-3 pb-0 bounce-100px ng-tns-c20-3"></i></div></div><app-about-us _ngcontent-sc20="" id="about-us" class="ng-tns-c20-3" _nghost-sc5=""><div _ngcontent-sc5="" id="about-us" class="flex justify-center w-full"><div _ngcontent-sc5="" class="max-w-[1300px] lg:p-10 p-5 flex lg:flex-row flex-col items-center lg:gap-20 gap-10"><img _ngcontent-sc5="" src="assets/imgs/about-us.png" alt=""><div _ngcontent-sc5=""><div _ngcontent-sc5="" class="optima-font flex items-center gap-3"><span _ngcontent-sc5="" class="text-[32px] lg:text-[68px]"> About </span><app-text-stroke _ngcontent-sc5="" text="Us" class="lg:block hidden ng-tns-c1-9 ng-star-inserted" _nghost-sc1=""><div _ngcontent-sc1="" class="flex ng-tns-c1-9 ng-star-inserted"><div _ngcontent-sc1="" class="main-text relative font-bold optima-font italic ng-tns-c1-9" style="font-size:68px;"> Us <div _ngcontent-sc1="" class="yellow-stroke absolute left-0 bottom-[15%] ng-tns-c1-9"><svg _ngcontent-sc1="" viewBox="0 0 130 12" xmlns="http://www.w3.org/2000/svg" class="yellow-stroke-svg ng-tns-c1-9 ng-trigger ng-trigger-strokeAnimation" style=""><!----><!----><path _ngcontent-sc1="" d="M3 8.99999C35.7456 1.93537 81.7418 0.116179 127 9" stroke="#E6A849" stroke-width="6" stroke-linecap="round" fill="none" class="ng-tns-c1-9 ng-star-inserted" style=""></path><!----><!----></svg></div></div></div><!----></app-text-stroke><app-text-stroke _ngcontent-sc5="" text="Us" class="lg:hidden ng-tns-c1-10 ng-star-inserted" _nghost-sc1=""><div _ngcontent-sc1="" class="flex ng-tns-c1-10 ng-star-inserted"><div _ngcontent-sc1="" class="main-text relative font-bold optima-font italic ng-tns-c1-10" style="font-size:32px;"> Us <div _ngcontent-sc1="" class="yellow-stroke absolute left-0 bottom-[15%] ng-tns-c1-10"><svg _ngcontent-sc1="" viewBox="0 0 130 12" xmlns="http://www.w3.org/2000/svg" class="yellow-stroke-svg ng-tns-c1-10 ng-trigger ng-trigger-strokeAnimation" style=""><!----><!----><!----><path _ngcontent-sc1="" d="M3 8.99999C35.7456 1.93537 81.7418 0.116179 127 9" stroke="#E6A849" stroke-width="8" stroke-linecap="round" fill="none" class="ng-tns-c1-10 ng-star-inserted" style=""></path><!----></svg></div></div></div><!----></app-text-stroke></div><div _ngcontent-sc5="" class="text-[16px] lg:text-[18px]"><span _ngcontent-sc5="" class="font-medium">Touchstone Partners</span> invests in early-stage tech startups that have the potential to change lives and shape the future of Vietnam<br _ngcontent-sc5=""><br _ngcontent-sc5=""> Through investing in talented and high integrity entrepreneurs, we are committed to delivering high impact, high returns, accelerating the way to a thriving and sustainable Vietnam <br _ngcontent-sc5=""><br _ngcontent-sc5=""> After we have done our due diligence, crunched the numbers, and gotten to know the founders, we ultimately ask ourselves a key question before we invest: <span _ngcontent-sc5="" class="font-medium italic">“If this startup succeeds, what difference will it make to Vietnam or the world?” </span><br _ngcontent-sc5=""><br _ngcontent-sc5=""></div></div></div></div></app-about-us><app-investment-thesis _ngcontent-sc20="" id="investment-thesis" class="ng-tns-c20-3" _nghost-sc2=""><div _ngcontent-sc2="" class="flex w-full justify-center lg:py-10 lg:px-20 p-5"><div _ngcontent-sc2="" class="flex flex-col items-center lg:gap-20 gap-10 lg:p-20 px-4 py-10 !bg-no-repeat !bg-cover max-w-[1320px] rounded-[30px] w-full" style="background: url('assets/imgs/Investment-Thesis-bg.png'); background-position-x: center !important;"><div _ngcontent-sc2="" class="optima-font lg:text-[38px] text-[20px] text-white font-semibold">Investment Thesis</div><div _ngcontent-sc2="" class="text-white lg:text-[44px] text-[28px] optima-font text-center font-semibold"> We write <span _ngcontent-sc2="" class="text-ts-yellow italic optima-font font-semibold">US$ 200k - 1 mil</span> checks for early stage startups tackling fundamental problems in Vietnam </div><div _ngcontent-sc2="" class="flex flex-col gap-10 w-full"><div _ngcontent-sc2="" class="optima-font text-white lg:text-[38px] text-[18px] text-center"> Our portfolio companies generate <br _ngcontent-sc2=""> potential widespread impact across Vietnam </div><div _ngcontent-sc2="" class="lg:flex flex-col gap-6 w-full ng-star-inserted"><div _ngcontent-sc2="" class="flex gap-6 justify-center w-full"><div _ngcontent-sc2="" class="investment-item flex flex-col items-center rounded-xl p-10 gap-4 w-1/4"><img _ngcontent-sc2="" src="assets/imgs/investment-1-icon.svg" alt="" class="h-[90px]"><div _ngcontent-sc2="" class="text-ts-blue text-[20px] text-center font-semibold min-h-[60px]">Patients supported</div></div><div _ngcontent-sc2="" class="investment-item flex flex-col items-center rounded-xl p-10 gap-4 w-1/4"><img _ngcontent-sc2="" src="assets/imgs/investment-2-icon.svg" alt="" class="h-[90px]"><div _ngcontent-sc2="" class="text-ts-blue text-[20px] text-center font-semibold min-h-[60px]">Moms and pops/<br _ngcontent-sc2="">microseller enabled</div></div><div _ngcontent-sc2="" class="investment-item flex flex-col items-center rounded-xl p-10 gap-4 w-1/4"><img _ngcontent-sc2="" src="assets/imgs/investment-3-icon.svg" alt="" class="h-[90px]"><div _ngcontent-sc2="" class="text-ts-blue text-[20px] text-center font-semibold min-h-[60px]">Learners empowered</div></div></div><div _ngcontent-sc2="" class="flex justify-center gap-6 w-full"><div _ngcontent-sc2="" class="investment-item flex flex-col items-center rounded-xl p-10 gap-4 w-1/4"><img _ngcontent-sc2="" src="assets/imgs/investment-4-icon.svg" alt="" class="h-[90px]"><div _ngcontent-sc2="" class="text-ts-blue text-[20px] text-center font-semibold min-h-[60px]">Farmers uplifted</div></div><div _ngcontent-sc2="" class="investment-item flex flex-col items-center rounded-xl p-10 gap-4 w-1/4"><img _ngcontent-sc2="" src="assets/imgs/investment-5-icon.svg" alt="" class="h-[90px]"><div _ngcontent-sc2="" class="text-ts-blue text-[20px] text-center font-semibold min-h-[60px]">CO2e reduced</div></div></div></div><!----><!----></div><div _ngcontent-sc2="" class="flex"><a _ngcontent-sc2="" href="/contact-us" class="bg-ts-yellow text-white py-2 px-5 rounded-[60px] lg:text-[24px] text-[20px] flex items-center gap-2 ease-in-out-2 hover:scale-105 cursor-pointer font-semibold"> Contact Us <img _ngcontent-sc2="" height="24" width="24" src="assets/imgs/ts-icon.svg" alt=""></a></div></div></div></app-investment-thesis><app-meet-portfolio _ngcontent-sc20="" id="portfolio" class="ng-tns-c20-3" _nghost-sc4=""><div _ngcontent-sc4="" class="flex w-full justify-center"><div _ngcontent-sc4="" class="flex items-center justify-center !bg-no-repeat w-full lg:h-[1000px] h-[663px]" style="background:url(assets/imgs/portfolio-bg.png) center no-repeat !important;"><div _ngcontent-sc4="" class="flex flex-col gap-5"><div _ngcontent-sc4="" class="lg:text-[48px] text-[28px] flex flex-col optima-font text-center"><div _ngcontent-sc4="" class="flex w-full">We invest in companies that</div><div _ngcontent-sc4="" class="flex justify-center"><app-text-stroke-circle _ngcontent-sc4="" text="uplift" class="lg:block hidden ng-tns-c3-11 ng-star-inserted" _nghost-sc3=""><div _ngcontent-sc3="" class="flex ng-tns-c3-11 ng-star-inserted"><div _ngcontent-sc3="" class="ng-tns-c3-11 font-bold italic leading-[48px] main-text optima-font relative text-[48px]"><span _ngcontent-s